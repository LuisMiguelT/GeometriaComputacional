%%% Counters and lengths
\ifx\section\undefined
  \newcounter{section}
\fi

\newlength{\mathwidth}
\ifx\mathindent\undefined
  \newdimen\mathindent\mathindent=\leftmargini
\fi
\setlength{\mathwidth}{\textwidth}
\addtolength{\mathwidth}{-1.1\mathindent}

%%% Spacing
\newcommand{\negbaselineskip}{\vspace*{-\baselineskip}}
\newcommand{\nextline}{$\strut$\newline\nobreak\ignorespaces}

%%% Theorems
\theoremstyle{change}
\theoremheaderfont{\bf}
\setlength\theorempreskipamount{6pt plus 2pt minus 2pt}
\setlength\theorempostskipamount{4pt plus 1.5pt minus 1.5pt}

\newtheorem{theorem}{\bf Theorem}[section]
%\newtheorem{algorithm}[mytheorem]{\bf Algorithm}
\newtheorem{conjecture}[theorem]{\bf Conjecture}
\newtheorem{corollary}[theorem]{\bf Corollary}
\newtheorem{definition}[theorem]{\bf Definition}
\newtheorem{example}[theorem]{\bf Example}
\newtheorem{lemma}[theorem]{\bf Lemma}
\newtheorem{model}[theorem]{\bf Model}
\newtheorem{observation}[theorem]{\bf Observation}
\newtheorem{problem}[theorem]{\bf Problem}
\newtheorem{openquest}[theorem]{\bf Open Questions}
\newtheorem{proposition}[theorem]{\bf Proposition}
\newtheorem{remark}[theorem]{\bf Remark}

%%% Theorem-like environments

\newenvironment{notation}
{
{\bf Notation}
\begin{quote}
}
{
\end{quote}
}

